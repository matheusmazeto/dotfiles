{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event post-tool-use --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event pre-compact --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event pre-tool-use --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event session-end --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event session-start --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/th3g3ntl3man/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event stop --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event subagent-start --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event subagent-stop --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "$HOME/Applications/ai-memory/ai-memory --data-dir \"$HOME/Library/Application Support/ai-memory\" hook --event user-prompt-submit --agent claude-code --server-url http://127.0.0.1:49374",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "statusLine": {
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi",
    "type": "command"
  },
  "theme": "dark-ansi"
}